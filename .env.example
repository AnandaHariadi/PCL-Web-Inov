# ─────────────────────────────────────────────────────────────
# PACUL environment variables. Copy to .env.local and fill in.
# Everything is optional: without any values PACUL runs fully in
# clearly-labelled DEMO mode.
# ─────────────────────────────────────────────────────────────

# Server-side ONLY (never prefix with NEXT_PUBLIC_).
# Enables live AI-assisted green-action verification (label detection)
# and Electricity Bill OCR (text detection). Enable the Cloud Vision API
# for this key and restrict it to that API.
GOOGLE_VISION_API_KEY=

# auto (default) = live if GOOGLE_VISION_API_KEY is set, otherwise demo
# live           = always call Vision; results become "Needs Review" if unavailable
# demo           = deterministic simulated results, no AI call (recommended for judging offline)
AI_VERIFICATION_MODE=auto

# Client-side demo mode for accounts/data (stored in the browser).
# Set to "false" only if you provide a compatible REST backend at NEXT_PUBLIC_API_URL.
NEXT_PUBLIC_DEMO_MODE=true
NEXT_PUBLIC_API_URL=

# Public site URL used for Open Graph metadata.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional custom map tiles (defaults to OpenStreetMap). If you change the
# host, also update img-src/connect-src in next.config.js.
NEXT_PUBLIC_MAP_TILE_URL=

# Optional Web Push public VAPID key. Sending pushes needs a backend (not included).
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
